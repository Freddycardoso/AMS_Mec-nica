---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "AMS serviços automotivos";
const pageDescription = "Precisa de manutenção automotiva em Passos/MG? Na Auto Mecânica Souza oferecemos diagnóstico preciso e serviços com garantia. Solicite seu orçamento rápido!";
const canonicalURL = "https://www.automecanicasouza.com.br/";
const whatsappNumber = "5535991995016";
const whatsappMessage = "Olá! Vi o site de vocês e preciso agendar uma avaliação/revisão para o meu veículo.";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const schemaData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "AutoRepair",
    "name": "Auto Mecânica Souza",
    "image": "https://www.automecanicasouza.com.br/logo.png",
    "url": canonicalURL,
    "telephone": "+5535991995016",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Av. dos Industriais, 297 - Monsenhor Messias",
      "addressLocality": "Passos",
      "addressRegion": "MG",
      "postalCode": "37901-215",
      "addressCountry": "BR"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "07:30",
        "closes": "18:00"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Qual o prazo para o diagnóstico do veículo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A maioria dos diagnósticos é realizada no mesmo dia. Utilizamos experiência e equipamentos dedicados para identificar com precisão o problema do seu carro em Passos/MG, garantindo rapidez e transparência."
        }
      },
      {
        "@type": "Question",
        "name": "Vocês dão garantia do serviço mecânico?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Com certeza. Todos os nossos serviços têm garantia total de mão de obra. Além disso, as peças instaladas na Auto Mecânica Souza acompanham a garantia integral do fabricante."
        }
      },
      {
        "@type": "Question",
        "name": "A Auto Mecânica Souza atende carros de todas as marcas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sim, atendemos veículos das principais marcas nacionais e importadas. Nossa equipe possui experiência multimarcas para oferecer a melhor manutenção preventiva e corretiva."
        }
      },
      {
        "@type": "Question",
        "name": "Quais as formas de pagamento aceitas na oficina?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Aceitamos Pix, cartões de débito e parcelamos nos principais cartões de crédito. Facilitamos o pagamento para que a manutenção do seu veículo seja acessível."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Manutenção Automotiva e Diagnóstico Mecânico",
    "provider": {
      "@type": "AutoRepair",
      "name": "Auto Mecânica Souza"
    },
    "areaServed": {
      "@type": "City",
      "name": "Passos",
      "sameAs": "https://pt.wikipedia.org/wiki/Passos_(Minas_Gerais)"
    }
  }
]);
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 
  canonicalURL={canonicalURL} 
  schema={schemaData}
  ogImage="https://www.automecanicasouza.com.br/logo.png"
>
  <Fragment slot="head">
    <!-- Preload das imagens críticas para carregar instantaneamente -->
    <link rel="preload" href="/images/garage_door_hq.webp?v=2" as="image" />
    <link rel="preload" href="/images/hero_hq.webp?v=2" as="image" />
    
    <!-- CSS Crítico Inline (Evita piscar/FOUC enquanto o CSS do Tailwind carrega) -->
    <style is:inline>
      html, body {
        background-color: #020617; /* bg-slate-950 */
      }
      #garage-door-preloader {
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100svh;
        z-index: 9999;
        background-color: #020617;
        background-image: url('/images/garage_door_hq.webp?v=2');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        box-shadow: 0 20px 50px rgba(0,0,0,0.9);
        border-bottom: 8px solid #0f172a;
        /* 1s de espera, 3.5s de subida pesada */
        animation: garage-door-inline 3.5s cubic-bezier(0.77, 0, 0.175, 1) 1s both;
      }
      @media (max-width: 768px) {
        #garage-door-preloader {
          /* Encaixe forçado: 100% 100% cobre a tela inteira, evita bordas pretas e evita cortar o logo nas laterais */
          background-size: 100% 100%;
          background-position: center;
        }
      }
      @keyframes garage-door-inline {
        0% { transform: translateY(0); }
        100% { transform: translateY(-100%); visibility: hidden; }
      }
    </style>
  </Fragment>
  <!-- Navbar - Industrial -->
  <header class="w-full bg-slate-950/90 backdrop-blur-md border-b border-slate-800 py-4 px-6 md:px-12 flex flex-wrap justify-between items-center sticky top-0 z-40 machined-edge">
    <div class="flex items-center gap-3">
      <img src="/logo.png" alt="Auto Mecânica Souza" class="h-10 md:h-12 w-auto object-contain drop-shadow-md" />
    </div>
    
    <!-- Nav Desktop -->
    <div class="hidden md:flex gap-4 font-mono text-sm tracking-wider uppercase">
      <a href="#problemas" class="text-slate-400 hover:text-white px-4 py-2 hover:bg-slate-900 hover:machined-edge transition-all duration-[160ms] ease-out-strong">Problemas</a>
      <a href="#servicos" class="text-slate-400 hover:text-white px-4 py-2 hover:bg-slate-900 hover:machined-edge transition-all duration-[160ms] ease-out-strong">Serviços</a>
      <a href="#lojas" class="text-slate-400 hover:text-white px-4 py-2 hover:bg-slate-900 hover:machined-edge transition-all duration-[160ms] ease-out-strong">Lojas</a>
      <a href="#faq" class="text-slate-400 hover:text-white px-4 py-2 hover:bg-slate-900 hover:machined-edge transition-all duration-[160ms] ease-out-strong">FAQ</a>
    </div>

    <!-- Mobile Menu Button -->
    <button id="mobile-menu-btn" class="md:hidden text-slate-300 hover:text-white p-2" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>

    <!-- Nav Mobile (Dropdown) -->
    <div id="mobile-menu" class="hidden w-full md:hidden flex flex-col font-mono text-sm tracking-wider uppercase mt-4 pt-4 border-t border-slate-800 gap-2">
      <a href="#problemas" class="mobile-link text-slate-300 hover:text-white py-3">Problemas</a>
      <a href="#servicos" class="mobile-link text-slate-300 hover:text-white py-3">Serviços</a>
      <a href="#lojas" class="mobile-link text-slate-300 hover:text-white py-3">Lojas</a>
      <a href="#faq" class="mobile-link text-slate-300 hover:text-white py-3">FAQ</a>
    </div>
  </header>
  
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const links = document.querySelectorAll('.mobile-link');
      
      btn?.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
      
      links.forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
        });
      });
    });
  </script>
  
  <!-- Preloader "Abertura de Garagem Real" movido para fora do header -->
  <div id="garage-door-preloader">
    <!-- Luz neon sutil na base da "porta" simulando o reflexo no chão antes de abrir -->
    <div style="height: 4px; width: 100%; background-color: rgba(220,38,38,0.5); box-shadow: 0 -15px 50px rgba(220,38,38,0.8);"></div>
  </div>

  <!-- Hero - Imagem no Topo no Mobile, Full Width no Desktop -->
  <section class="relative w-full min-h-[100svh] flex flex-col justify-start md:justify-center px-0 md:px-12 pt-0 md:py-20 bg-slate-950 overflow-hidden">
    <!-- Fundo base preto -->
    <div class="absolute inset-0 z-0 bg-slate-950 pointer-events-none"></div>

    <!-- IMAGEM HERO: Container de altura fixa no mobile, centralizada, com zoom leve -->
    <div class="relative md:absolute md:inset-0 z-0 flex w-full h-[50svh] md:h-full animate-hero-zoom origin-center overflow-hidden">
      <!-- Imagem deslocada para a esquerda (foco na direita 100%) p/ alinhar perfeitamente carro e logo -->
      <img 
        src="/images/hero_hq.webp?v=2" 
        alt="Carro Audi em galpão com Letreiro 3D" 
        class="w-full h-full object-cover object-right md:object-center scale-[1.1] md:scale-100 contrast-[1.15] saturate-[1.2]"
      />
      <!-- Fade simples e leve apenas na borda inferior -->
      <div class="block md:hidden absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-slate-950 to-transparent pointer-events-none"></div>
      
      <!-- Fades desktop -->
      <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-transparent w-[50%] pointer-events-none"></div>
      <div class="hidden md:block absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at center, transparent 40%, #020617 90%);"></div>
    </div>

    <!-- Fade de transição super suave rodapé desktop -->
    <div class="hidden md:block absolute bottom-0 left-0 w-full h-32 md:h-48 bg-gradient-to-t from-slate-950 to-transparent pointer-events-none z-0"></div>
    
    <!-- Texto do Hero: Imediatamente abaixo da imagem no mobile, e à esquerda no desktop -->
    <div class="relative z-10 w-full px-6 md:px-0 max-w-2xl text-center md:text-left mx-auto md:mx-0 flex flex-col items-center md:items-start pb-12 mt-4 md:mt-0">
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold text-white leading-[1.05] tracking-tight uppercase mb-6 md:mb-8 animate-text-reveal [animation-delay:2.5s]">
        Você não precisa entender de mecânica, <br/>
        <span class="text-red-600 drop-shadow-lg">só precisa de quem entende.</span>
      </h1>
      <p class="text-base md:text-xl text-slate-300 font-medium leading-relaxed max-w-xl mb-8 md:mb-12 animate-text-reveal [animation-delay:3.0s]">
        Diagnóstico preciso e manutenção transparente em Passos/MG. Nós mostramos exatamente o que precisa ser feito, sem enrolação.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 md:gap-6 items-stretch sm:items-center animate-text-reveal [animation-delay:3.5s]">
        <a href={whatsappLink} class="inline-flex items-center justify-center gap-3 px-6 md:px-8 py-4 md:py-5 bg-blue-600 text-white font-black uppercase tracking-wider hover:bg-blue-500 transition-all duration-[160ms] ease-out-strong active:scale-[0.97] machined-edge-strong shadow-lg shadow-blue-900/50">
          Agendar Avaliação
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Seção 2: Problemas Comuns -->
  <section id="problemas" class="w-full bg-slate-950 py-24 border-b border-slate-800">
    <div class="container mx-auto px-6 md:px-12 max-w-7xl">
      <div class="mb-16 max-w-2xl reveal-up">
        <h2 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight uppercase leading-none mb-6">
          Sinais que seu carro <br/>
          <span class="text-slate-500">pede socorro.</span>
        </h2>
        <p class="text-xl text-slate-400">
          Oficinas comuns trocam peças na base do "achismo". Nós mapeamos o sintoma e resolvemos na raiz.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {[
          { symptom: "Luz da injeção acesa", desc: "Diagnóstico computadorizado avançado para encontrar a falha eletrônica exata." },
          { symptom: "Barulho metálico ao frear", desc: "Inspeção completa de pastilhas e discos para garantir sua segurança." },
          { symptom: "Vibração no volante", desc: "Alinhamento e balanceamento de alta precisão." },
          { symptom: "Ar condicionado fraco", desc: "Recarga de gás, higienização e reparo de vazamentos no sistema." },
          { symptom: "Carro falhando ou engasgando", desc: "Limpeza de bicos, verificação de velas e de todo o sistema de ignição." },
          { symptom: "Manchas de óleo no chão", desc: "Inspeção rigorosa do cárter, juntas e retentores para sanar vazamentos." }
        ].map(item => (
          <div class="relative bg-gradient-to-br from-slate-900 to-slate-950 border border-slate-800/80 p-8 rounded-sm hover:border-red-600/50 transition-all duration-300 group reveal-up flex flex-col overflow-hidden">
            <!-- Efeito de brilho/scan no hover -->
            <div class="absolute -inset-px bg-gradient-to-r from-red-600/0 via-red-600/0 to-red-600/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <!-- Linha de detalhe no topo -->
            <div class="absolute top-0 left-0 w-full h-[2px] bg-slate-800 group-hover:bg-red-600 transition-colors duration-300"></div>
            
            <div class="flex items-center justify-end mb-6 relative z-10">
              <!-- Indicador estilo painel de carro (luz de alerta) -->
              <div class="w-2 h-2 rounded-full bg-slate-700 group-hover:bg-red-600 group-hover:shadow-[0_0_10px_rgba(220,38,38,0.8)] group-hover:animate-pulse transition-all duration-300"></div>
            </div>
            
            <h3 class="font-bold text-xl text-white uppercase tracking-tight mb-3 relative z-10 group-hover:text-red-50 transition-colors">{item.symptom}</h3>
            <p class="text-slate-400 leading-relaxed flex-grow relative z-10">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 flex justify-center reveal-up">
        <div class="inline-flex flex-col sm:flex-row items-center gap-6 bg-slate-900/60 p-6 md:p-8 rounded-sm border border-slate-800">
          <div class="text-center sm:text-left max-w-md">
            <h4 class="text-xl font-bold text-white mb-2 uppercase tracking-tight">Identificou algum desses sinais?</h4>
            <p class="text-slate-400 text-sm leading-relaxed">Não espere o problema se agravar. Uma avaliação rápida evita prejuízos enormes e garante a sua segurança.</p>
          </div>
          <a href={whatsappLink} class="whitespace-nowrap inline-flex items-center justify-center gap-3 px-8 py-4 bg-blue-600 text-white font-black uppercase tracking-wider hover:bg-blue-500 transition-all duration-[160ms] ease-out-strong active:scale-[0.97] machined-edge-strong shadow-lg shadow-blue-900/50">
            Falar com Especialista
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção 3: Serviços com Fotos Reais -->
  <section id="servicos" class="w-full bg-slate-900 py-24 border-b border-slate-800">
    <div class="container mx-auto px-6 md:px-12 max-w-7xl">
      <div class="flex flex-col mb-16 reveal-up">
        <h2 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight uppercase leading-none">
          Nossas <span class="text-slate-500">Especialidades</span>
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Troca de Óleo e Filtros -->
        <div class="bg-slate-950 border border-slate-800 p-8 rounded-sm hover:machined-edge transition-all duration-[160ms] ease-out-strong group flex flex-col reveal-up">
          <div class="w-full aspect-video mb-8 overflow-hidden rounded-sm bg-slate-900">
            <img src="/images/troca_oleo.jpg" alt="Troca de Óleo e Filtros" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
          </div>
          <h3 class="font-bold text-2xl md:text-3xl text-white mb-4 uppercase tracking-tight mt-2">Troca de Óleo<br/>e Filtros</h3>
          <p class="text-slate-400 text-lg leading-relaxed flex-grow">Lubrificação correta é a vida do motor. Trabalhamos com óleos de alta performance para garantir durabilidade e eficiência máxima do seu veículo.</p>
        </div>
        
        <!-- Suspensão e Freios -->
        <div class="bg-slate-950 border border-slate-800 p-8 rounded-sm hover:machined-edge transition-all duration-[160ms] ease-out-strong group flex flex-col reveal-up" style="transition-delay: 50ms;">
          <div class="w-full aspect-video mb-8 overflow-hidden rounded-sm bg-slate-900">
            <img src="/images/freios_suspensao.jpg" alt="Suspensão e Freios" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
          </div>
          <h3 class="font-bold text-2xl md:text-3xl text-white mb-4 uppercase tracking-tight mt-2">Suspensão<br/>e Freios</h3>
          <p class="text-slate-400 text-lg leading-relaxed flex-grow">Sua segurança não aceita economia burra. Utilizamos peças certificadas para garantir estabilidade e frenagem perfeita.</p>
        </div>

        <!-- Injeção Eletrônica -->
        <div class="bg-slate-950 border border-slate-800 p-8 rounded-sm hover:machined-edge transition-all duration-[160ms] ease-out-strong group flex flex-col reveal-up">
          <div class="w-full aspect-video mb-8 overflow-hidden rounded-sm bg-slate-900">
            <img src="/images/injecao_motor.jpg" alt="Injeção Eletrônica" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
          </div>
          <h3 class="font-bold text-2xl md:text-3xl text-white mb-4 uppercase tracking-tight mt-2">Injeção<br/>Eletrônica</h3>
          <p class="text-slate-400 text-lg leading-relaxed flex-grow">Limpeza, equalização de bicos e parametrização do sistema para seu motor rodar suave, forte e econômico.</p>
        </div>

        <!-- Revisão Preventiva -->
        <div class="bg-slate-950 border border-slate-800 p-8 rounded-sm hover:machined-edge transition-all duration-[160ms] ease-out-strong group flex flex-col reveal-up" style="transition-delay: 50ms;">
          <div class="w-full aspect-video mb-8 overflow-hidden rounded-sm bg-slate-900">
            <img src="/images/revisao_preventiva.jpg" alt="Revisão Preventiva" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
          </div>
          <h3 class="font-bold text-2xl md:text-3xl text-white mb-4 uppercase tracking-tight mt-2">Revisão<br/>Preventiva</h3>
          <p class="text-slate-400 text-lg leading-relaxed flex-grow">Prevenção custa muito menos que o guincho. Check-up completo de fluidos, filtros, correias e itens de segurança.</p>
        </div>

        <!-- Embreagem e Câmbio -->
        <div class="bg-slate-950 border border-slate-800 p-8 rounded-sm hover:machined-edge transition-all duration-[160ms] ease-out-strong group flex flex-col reveal-up">
          <div class="w-full aspect-video mb-8 overflow-hidden rounded-sm bg-slate-900">
            <img src="/images/embreagem_cambio.jpg" alt="Embreagem e Câmbio" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
          </div>
          <h3 class="font-bold text-2xl md:text-3xl text-white mb-4 uppercase tracking-tight mt-2">Embreagem<br/>e Câmbio</h3>
          <p class="text-slate-400 text-lg leading-relaxed flex-grow">Troca de kits de embreagem e manutenção de caixas de marcha com precisão, devolvendo a maciez e controle total da tração.</p>
        </div>

        <!-- Manutenção de Motor -->
        <div class="bg-slate-950 border border-slate-800 p-8 rounded-sm hover:machined-edge transition-all duration-[160ms] ease-out-strong group flex flex-col reveal-up" style="transition-delay: 50ms;">
          <div class="w-full aspect-video mb-8 overflow-hidden rounded-sm bg-slate-900">
            <img src="/images/manutencao_motor.jpg" alt="Manutenção de Motor" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
          </div>
          <h3 class="font-bold text-2xl md:text-3xl text-white mb-4 uppercase tracking-tight mt-2">Manutenção<br/>de Motor</h3>
          <p class="text-slate-400 text-lg leading-relaxed flex-grow">Reparos no coração do seu veículo. Desde troca de correia dentada e juntas até retífica parcial, com a brutalidade e honestidade que a mecânica exige.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção: Nossas Lojas -->
  <section id="lojas" class="w-full bg-slate-950 py-24 border-b border-slate-800">
    <div class="container mx-auto px-6 md:px-12 max-w-7xl">
      <div class="mb-16 max-w-2xl reveal-up">
        <h2 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight uppercase leading-none mb-6">
          Nossas <br/><span class="text-blue-600">Unidades</span>
        </h2>
        <p class="text-xl text-slate-400">
          Duas estruturas completas, padronizadas e prontas para receber seu veículo com o mesmo nível de excelência técnica. 
          <br/><span class="text-white font-bold mt-2 inline-block">As duas lojas ficam no mesmo endereço, literalmente uma ao lado da outra!</span>
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 md:gap-8">
        <!-- Loja 1 -->
        <div class="group flex flex-col reveal-up bg-slate-900/40 md:bg-transparent p-6 md:p-0 border border-slate-800 md:border-none rounded-sm">
          <h3 class="font-black text-2xl md:text-3xl text-white uppercase tracking-tight mb-6 pb-4 border-b border-slate-800/60 flex items-center justify-between">
            <span>Unidade I</span>
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="w-full aspect-[4/3] overflow-hidden rounded-sm bg-slate-900 border border-slate-800 relative">
              <img src="/images/loja_1.jpeg" alt="Fachada Loja 1" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 delay-100" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent flex items-end p-4">
                <span class="text-white font-mono text-sm tracking-widest font-bold drop-shadow-md">FACHADA</span>
              </div>
            </div>
